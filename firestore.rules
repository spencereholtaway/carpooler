rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.riders == [];

      // Driver can edit/delete their own trip.
      // Any signed-in user may update only the `riders` field (join/leave).
      allow update: if request.auth != null && (
        resource.data.driverId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riders'])
      );

      allow delete: if request.auth != null && resource.data.driverId == request.auth.uid;
    }
  }
}
